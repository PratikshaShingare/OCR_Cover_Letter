# Khanna Travels & Holidays — Environment Configuration Example

# Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# OCR Provider Configuration
# Options: 'mock' (default, includes reference cases + MRZ pattern matching), 'google_vision', 'azure_document_intelligence'
OCR_PROVIDER=mock
OCR_API_KEY=
OCR_ENDPOINT=

# Database Configuration (SQLite default; PostgreSQL ready for enterprise scale)
DATABASE_URL=sqlite:///./khanna_visa.db

# Storage / Security Settings
MAX_UPLOAD_SIZE_MB=10
AUTO_DELETE_TEMP_FILES_AFTER_MINUTES=60
